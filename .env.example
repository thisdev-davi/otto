# Banco de dados (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://otto:otto@localhost:5437/otto

# Redis (broker Celery + pub/sub WebSocket)
DATABASE_DIRECT_URL=
SQL_ECHO=false

REDIS_URL=redis://localhost:6382/0

# Evolution API (WhatsApp — MVP)
EVOLUTION_URL=http://localhost:8084
# Base pública onde o Evolution entrega os webhooks. Se ficar VAZIO o pareamento
# funciona, o QR conecta, e mesmo assim NENHUMA mensagem chega — o provision não
# registra o webhook e a falha é totalmente silenciosa.
# Docker no Linux: use o gateway da rede do compose (`docker network inspect`),
# porque host.docker.internal só resolve com extra_hosts: "host.docker.internal:host-gateway".
WEBHOOK_BASE_URL=http://host.docker.internal:8001
# Autentica os webhooks que o Evolution nos entrega E as chamadas que fazemos a ele.
# GERE O SEU — não deixe `changeme` fora de dev:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Fora de ENV=dev o boot ABORTA se este valor for de exemplo (app/core/config.py).
EVOLUTION_API_KEY=changeme

# JWT — assina os tokens e deriva a chave que criptografa as chaves de LLM dos tenants.
# Mesma regra acima: gere o seu, e trocar depois invalida as chaves já guardadas.
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anti-flood do bot: não auto-responde mensagens mais antigas que isto (segundos).
# Protege contra o backlog que o WhatsApp entrega ao (re)conectar. 0 = desliga.
BOT_REPLY_MAX_AGE_SECONDS=300

# Silêncio (segundos) que encerra a conversa. A próxima mensagem do cliente abre
# uma conversa NOVA, com o roteiro começando do começo — em vez de continuar
# parada na pergunta em que ele sumiu. Conversa capturada por atendente ou já
# encaminhada à equipe nunca é encerrada. 0 = desliga.
CONVERSA_INATIVA_SEGUNDOS=3600

# CORS (lista JSON)
CORS_ORIGINS=["http://localhost:3002"]

# Ambiente
ENV=dev

# Há nginx (ou outro reverse proxy) na frente? Só com `true` o X-Forwarded-For é usado
# para identificar o cliente no rate limit. Ligar SEM proxy real deixa qualquer um forjar
# o próprio IP; deixar `false` ATRÁS de proxy faz todo mundo dividir o mesmo balde.
TRUSTED_PROXY=false
# Quantos proxies acrescentam itens ao X-Forwarded-For (o IP do cliente é o N-ésimo da direita).
TRUSTED_PROXY_HOPS=1

# Rate limits (janela em segundos). Login conta por IP e por e-mail, separadamente.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_JANELA=60
RATE_LIMIT_WEBHOOK=300
RATE_LIMIT_WEBHOOK_JANELA=60

# Teto diário de turnos do agente POR TENANT. Os limites do orquestrador são por conversa,
# e abrir conversa é grátis para quem manda mensagem — este é o único teto real de gasto
# com LLM. 0 desliga.
AI_MAX_TURNS_DIA=500

# Agente de IA (fallback quando o tenant não configura chave no painel)
# Providers: stub | anthropic | openai | xai | gemini | deepseek | groq
LLM_PROVIDER=stub
# Deixe VAZIO. Cada provider conhecido já tem um padrão em app/ai/llm.py::_DEFAULT_MODEL
# (gemini → gemini-3.1-flash-lite), e esta variável só é consultada para provider fora
# dessa lista. Fixar um modelo aqui é a armadilha clássica: trocar o default é uma linha
# no código, mas um valor deixado para trás AQUI ignora a troca e quebra o agente sem
# nenhum aviso.
#
# ATENÇÃO ao modelo do Gemini: o Google aposenta família inteira para CHAVE NOVA sem
# tirar do /models (a 2.5 devolve 404 "no longer available to new users" para chave
# posterior a ~09/07/2026). Se o agente emudecer e o áudio parar de transcrever ao
# mesmo tempo, é isto — o log do worker traz o 404, e a correção é o default em
# app/ai/llm.py, não esta linha.
LLM_MODEL=
LLM_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings do RAG vetorial. Só gemini e openai sabem embedar (o groq não tem
# endpoint de embeddings). Deixe as duas linhas VAZIAS para herdar LLM_PROVIDER/
# LLM_API_KEY acima — uma chave Gemini cobre conversa e indexação, sem conta na
# OpenAI. Preencha só para embedar num provedor diferente do que conversa.
EMBEDDINGS_PROVIDER=openai           # gemini | openai (ignorado se a chave abaixo estiver vazia)
EMBEDDINGS_API_KEY=

# Mídia inbound + transcrição de áudio
#
# NORMALMENTE NÃO PRECISA PREENCHER. A transcrição usa a chave que o tenant já
# configurou no painel (Agente de IA), então quem está no Gemini transcreve com ela —
# o Gemini não tem /audio/transcriptions, mas transcreve nativamente pelo
# generateContent, e o modelo padrão do agente aceita áudio.
#
# O que está abaixo é o FALLBACK, para dois casos: provedor de chat que não transcreve
# (xai, deepseek, anthropic), ou querer separar a conta do áudio de propósito.
MEDIA_DIR=data/media
TRANSCRIPTION_PROVIDER=groq          # gemini | groq | openai
# Vazio = default do provider (groq: whisper-large-v3-turbo). NÃO ponha comentário
# na mesma linha de variável vazia: o dotenv só descarta comentário depois de um
# valor, e aqui o texto inteiro viraria o nome do modelo.
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=

# Seed de canais (seed_channels.py)
EVOLUTION_INSTANCE=otto-test

# Persist backend in every media locator. Object storage must be private.
MEDIA_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=auto
# Override for a registry image built/published by you; compose only starts it explicitly.
EVOLUTION_IMAGE=
